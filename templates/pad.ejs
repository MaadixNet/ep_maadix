<!doctype html>
<html>
  <head>
    <title>Edit Pad</title>
    <base href="<%= baseUrl %>/" />
    <%- include('blocks/head', { settings: settings }) %>
  </head>
  <body>
    <%- include('blocks/header', { isAdmin: isAdmin, settings: settings, username: username, userid: userid  }) %>

    <div id="main">
      <div class="inside">
        <% if (padurl && groupID) { %>
        <iframe src="<%= padurl %>" width="100%" id="iframePad"></iframe>
        <% } else { %>
        <h2 class="title center">This pad does not exists</h2>
        <% } %>
      </div>
    </div>
  </body>
</html>
<script src="../../../static/plugins/ep_maadix/static/js/client/end.js" type="text/javascript"></script>
<script>
  $(document).ready(function () {
    var curuser = $('#currentuser').data('username');
    console.log('Curuser ' + curuser);
    $('#myusernameedit').addClass('WTF').val(curuser);
  });
</script>
