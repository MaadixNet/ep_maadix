<!doctype html>
<html>
  <head>
    <title>Edit profile</title>
    <base href="<%= baseUrl %>/" />
    <%- include('blocks/head', { settings: settings }) %>
  </head>
  <body>
    <%- include('blocks/header', { isAdmin: isAdmin, settings: settings, username: user.username, userid: user.userID }) %>

    <article class="content items-list-page">
      <div id="wrapper">
        <div class="title-block">
          <div class="row">
            <div class="col-md-12"></div>
          </div>
        </div>

        <div id="inner">
          <% if (errors.length) { %>
          <div class="errors">
            <% errors.forEach(function (item) { %>
            <div class="error"><%= item.toString() %></div>
            <% }) %>
          </div>
          <% } %>
          <div id="formblock" class="confirm">
            <form id="formEtherpadEditProfile" method="post" class="white" autocomplete="off">
              <div class="title-block">
                <h3 class="title" lang="en">Edit profile</h3>
              </div>
              <% if (message) { %>
              <div class="resMessage"><%= message %></div>
              <% } %>
              <div class="formBody">
                <label for="email">E-mail</label>
                <input type="email" name="email" id="email" value="<%= user.email %>" class="smallMarginBottom" />
                <label for="username">Username</label>
                <input type="text" name="username" id="username" value="<%= user.name %>" />

                <label for="fullname">Fullname</label>
                <input type="text" name="fullname" id="fullname" value="<%= user.FullName%>" />

                <label for="password">Password</label>
                <input type="password" name="password" id="password" placeholder="Password" />

                <label for="passwordrepeat">Repeat password</label>
                <input type="password" name="passwordrepeat" id="passwordrepeat" placeholder="Confirm Password" />

                <input type="hidden" name="userid" id="userid" value="<%= userid %>" />
                <button type="submit" lang="en">Save changes</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </article>
  </body>
</html>
<script src="../static/plugins/ep_maadix/static/js/client/end.js" type="text/javascript"></script>
