    <header>
      <div class="header-block header-block-buttons">
        <% if (authenticated) { %>
        <div class="header-block header-block-nav first">
          <a class="btn btn-sm header-btn" href="dashboard"><i class="demo-icon icon-home home-menu">&#xe81d;</i> My Groups</a> |
          <% if (settings.public_pads) { %>
          <a class="btn btn-sm header-btn" href="">Public Pad</a> |
          <% } %>
          <a class="btn btn-sm header-btn" href="help">Help</a>
        </div>
        <div class="header-block header-block-nav second">
          <ul id="profile">
            <li>
              <span class="name"
                ><i class="demo-icon icon-user">&#xe800;</i>
                <%= username %>
                <i class="demo-icon icon-down-dir-1">&#xe818;</i></span
              >
              <ul>
          <% if (isAdmin) { %>
          <li><a class="btn btn-sm header-btn" href="settings">Settings</a></li>
          <% } %>

                <li><a class="dropdown-item" href="user/<%= userid %>">My Profile</a></li>
                <li><a class="dropdown-item" href="./logout">Logout</a></li>
              </ul>
            </li>
          </ul>
        </div>
        <% } else { %>
        <div class="header-block header-block-nav first"></div>
        <div class="header-block header-block-nav second">
          <ul id="profile">
          <li><a class="btn btn-sm header-btn" href="settings">Settings</a></li> |
            <li>
              <span class="name"
                ><a href="login"><i class="demo-icon icon-user">&#xe800;</i> Login</a></span
              >
            </li>

            <%if (settings.register_enabled ==1) { %>
            <li><a class="button" href="register">Register</a></li>
            <% } %>
          </ul>
        </div>

        <% } %>
      </div>
    </header>

