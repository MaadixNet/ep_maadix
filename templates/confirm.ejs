<!doctype html>
<html>
  <head>
    <title>Etherpad confirm</title>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
    <link rel="shortcut icon" href="../favicon.ico" />
    <script src="../static/plugins/ep_maadix/static/js/client/jquery.js" type="text/javascript"></script>
    <link href="../static/plugins/ep_maadix/static/css/custom.css" rel="stylesheet" />
  </head>
  <article class="content items-list-page">
    <div id="wrapper">
      <div class="title-block">
        <div class="row">
          <div class="col-md-12"></div>
        </div>
      </div>

      <div id="inner">
        <div id="formblock" class="confirm">
          <form id="formEtherpadConfirm" class="white" autocomplete="off">
            <div class="title-block">
              <h3 class="title" lang="en">Activate account</h3>
            </div>
            <label for="email">E-mail (please use the same email account you have received the invitation for)</label>
            <input type="text" name="email" id="email" placeholder="E-mail address" class="smallMarginBottom" required />
            <label for="username">Username (choose a username)</label>
            <input type="text" name="username" id="username" placeholder="choose a User Name" required />
            <label for="password">Password</label>
            <input type="password" name="password" id="password" placeholder="Password" required />
            <label for="passwordrepeat">Repeat password</label>
            <input type="password" name="passwordrepeat" id="passwordrepeat" placeholder="Confirm Password" required />
            <input type="hidden" name="baseurl" id="baseurl" value="" />
            <input type="hidden" name="tok" id="tok" value="<%= tok %>" />
            <button type="submit" lang="en">Create Account</button>
          </form>
        </div>
      </div>
    </div>
  </article>
</html>
<script src="../static/plugins/ep_maadix/static/js/client/end.js" type="text/javascript"></script>
