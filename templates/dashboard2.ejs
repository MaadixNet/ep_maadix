<!doctype html>
<html>
  <head>
    <title>Dashboard</title>
    <base href="<%= baseUrl %>/" />
    <%- include('blocks/head', { settings: settings }) %>
  </head>
  <body>
    <%- include('blocks/header', { isAdmin: isAdmin, settings: settings, username: username, userid: userid }) %>

    <article class="content items-list-page">
      <div id="wrapper" class="title-search-block">
        <div class="title-block">
          <div class="row">
            <div class="col-md-6">
              <h3 class="title" lang="en">Manage Groups</h3>
            </div>
            <div class="col-md-6">
              <div class="inputBlock">
                <h4 lang="en">Create a new Private Group</h4>
                <form id="createPrivateGroupForm">
                  <input type="text" placeholder="Group-Name" id="groupName" autocomplete="off" />
                  <button type="submit" lang="en" id="createPrivateGroup">Create</button>
                </form>
              </div>
            </div>
          </div>
        </div>
        <%if (groups.length > 0) {%>
        <table class="card items">
          <thead>
            <tr>
              <th>Group</th>
              <th>Role</th>
              <th>Manage Users</th>
              <th>Manage Pads</th>
              <th>Delete</th>
            </tr>

            <tr></tr>
          </thead>
          <% for(var i = 1; i <= groups.length; i++){%>
          <tr class="visible" id="Gruppe<%= groups[i-1].groupID%>" data-role="<%= groups[i-1].Role%>">
            <td class="first"><a href="group/<%= groups[i-1].groupID%>"><%= groups[i-1].name%></a></td>
            <td class="userGroupRole" data-usergrouprole="<%= groups[i-1].Role%>"><span class="textrole"><%=groups[i-1].Role%></span></td>
            <td class="first"><a href="groupusers/<%= groups[i-1].groupID%>">View <%if (groups[i-1].Role < 3) {%>/Add <%}%> Users</a></td>
            <td class="first"><a href="group/<%= groups[i-1].groupID%>">View/Add Pads</a></td>
            <%if (groups[i-1].Role == 1) {%>
            <td title="Delete Group" class="last">
              <a data-groupid="<%=groups[i-1].groupID%>" data-name="<%=groups[i-1].name%>" class="deleteGroup"><i class="demo-icon icon-trash">&#xe801;</i></a>
            </td>
            <%} else {%>
            <td class="last"><i class="demo-icon icon-block">&#xe81c;</i></td>
            <%}%>
          </tr>
          <% } %>
        </table>
      </div>
      <%} else {%>
      <h4 class="red" lang="en">You are in no Group at the moment.</h4>
      <%}%>
      <div style="clear: both"></div>
    </article>
    <script>
      $(document).ready(function () {
        $('#logout').click(function (e) {
          e.defaultPrevented();

          var data = {};
          var loc = document.location,
            port = loc.port == '' ? (loc.protocol == 'https:' ? 443 : 80) : loc.port,
            url = loc.protocol + '//' + loc.hostname + ':' + port + '/';

          data.location = url;
          $.ajax({
            type: 'POST',
            data: JSON.stringify(data),
            contentType: 'application/json',
            url: url + 'logout',
            success: function (data) {
              window.location = '../index.html';
            },
            error: function (xhr, ajaxOptions, thrownError) {
              console.log(thrownError);
            },
          });
        });
      });
    </script>
  </body>
</html>
