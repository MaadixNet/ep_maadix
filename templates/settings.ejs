<!doctype html>
<html>
  <head>
    <title>Settings</title>
    <base href="<%= baseUrl %>/" />
    <%- include('blocks/head', { settings: settings }) %>
      
    <link href="static/plugins/ep_maadix/static/css/settings.css" rel="stylesheet" />
  </head>
  <body>
    <%- include('blocks/header', { isAdmin: isAdmin, settings: settings, username: username, userid: userid  }) %>

    <div id="wrapper">
      <% if (isAdmin) { %> <% if (errors.length) { %>
      <div class="errors">
        <% errors.forEach(function (item) { %>
        <div class="error"><%= item.toString() %></div>
        <% }) %>
      </div>
      <% } %>

      <%- include('blocks/settings-menu', { settings: settings }) %>
      <div class="innerwrapper">
        <article class="content items-list-page">
          <div id="main">
            <div class="inside">
              <div class="inputBlock">
                <h3>Settings</h3>
                <form id="setSettingsForm">
                  <div class="margin20">
                    <div class="form_field">
                      <% if (settings.register_enabled === 1) { %>
                      <input type="checkbox" id="register_enabled" name="register_enabled" value="<%=settings.register_enabled%>" checked />
                      <% } else { %>
                      <input type="checkbox" id="register_enabled" name="register_enabled" value="<%=settings.register_enabled%>" />
                      <% } %>
                      Allow users to register
                    </div>
                    <div class="form_field">
                      <% if (settings.recover_pw === 1) { %>
                      <input type="checkbox" id="recover_pw" name="recover_pw" value="<%=settings.recover_pw%>" checked />
                      <% } else { %>
                      <input type="checkbox" id="recover_pw" name="recover_pw" value="<%=settings.recover_pw%>" />
                      <% } %>
                      Allow users to recover lost password
                    </div>
                    <div class="form_field">
                      <% if (settings.public_pads === 1) { %>
                      <input type="checkbox" id="public_pads" name="public_pads" value="<%=settings.public_pads%>" checked />
                      <% } else { %>
                      <input type="checkbox" id="public_pads" name="public_pads" value="<%=settings.public_pads%>" />
                      <% } %>
                      Allow public pads. (NOTE: you have to restart Etherpad to apply this new setting. For that go to Etherpad core Settings - 'Settings' tab on the admin interface left menu - and click 'Restart Etherpad' button at the bottom of the page)
                    </div>
                    <br />
                  </div>
                  <button type="submit" lang="en" id="setSettingsForm">Save</button>
                </form>
              </div>
            </div>
          </div>
        </article>
      </div>

      <% } else { %>
      <article class="content items-list-page">
        <div id="main">
          <div class="inside">
            <div class="inputBlock">
              <div class="login-background login-page">
                <div class="login-box login-form">
                  <h1 class="login-title">Etherpad</h1>
                  <p>To edit Group Pads settings, you need to loogin using the etherpad admin credentials</p>
                  <form class="login-inner-box input-control" id="adminLloginForm">
                    <div>Username</div>
                    <input class="login-textinput input-control" placeholder="Username" type="text" name="username" id="username" />
                    <div>Password</div>
                    <input class="login-textinput" placeholder="Password" type="password" name="password" id="password" />
                    <input class="login-button" type="submit" value="Login" name="adminLloginForm" />
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>

    <% }  %>
    <div style="display: none"><a href="/javascript" data-jslicense="1">JavaScript license information</a></div>
  </body>
</html>
